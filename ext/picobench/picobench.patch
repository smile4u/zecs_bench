+                // zecs_bench patch: the median sample and the median absolute percent
+                // error (MdAPE) of the samples. MdAPE is the median of |t - median| / t.
+                // 0.05 means that half of the samples are within 5% of the median.
+                // For an even number of samples the median is the upper middle sample.
+                auto median = [](auto values)
+                {
+                    auto middle = values.begin() + long(values.size() / 2);
+                    std::nth_element(values.begin(), middle, values.end());
+                    return *middle;
+                };
+                for (auto& d : rpt_benchmark->data)
+                {
+                    std::vector<int64_t> times;
+                    for (auto& state : b->_states)
+                    {
+                        if (state.iterations() == d.dimension)
+                            times.push_back(state.duration_ns());
+                    }
+                    d.median_time_ns = median(times);
+
+                    std::vector<double> errors;
+                    for (auto t : times)
+                        errors.push_back(double(std::abs(t - d.median_time_ns)) / double(t));
+                    d.median_error = median(errors);
+                }
